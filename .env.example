# ── Server ───────────────────────────────────────────────
PORT=3001
# Where records, the Excel sheet and (without Google Drive) uploaded files live
# DATA_DIR=./data
# Set to 1 when running behind a reverse proxy (nginx, Render, Railway…) so rate limiting sees real IPs
# TRUST_PROXY=1

# ── Google Drive + Sheet via Apps Script (recommended; uses apps-script/Code.gs, no Google Cloud project needed) ──
# Deploy apps-script/Code.gs as a Web app, paste the /exec URL here, and set the same secret as SECRET in Code.gs.
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=

# ── Google Drive API (alternative; leave empty to store files in ./data/uploads/<ID> instead) ──
# Option A – a normal Google account (e.g. @gmail.com). Run `npm run google:auth` once to get the token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Option B – Google Workspace service account (the parent folder must be on a Shared Drive)
# GOOGLE_SERVICE_ACCOUNT_FILE=./credentials.json

# Folder that will contain one sub-folder per application ID.
# Open the folder in Drive and copy the last part of its URL. Empty = "My Drive".
GOOGLE_DRIVE_PARENT_FOLDER_ID=
